rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ─────────────────────────────────────────────────────────────────
    // Only the authenticated user can read or write their own profile document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── User Vocabulary ───────────────────────────────────────────────────────
    // A user may only access vocabulary items that belong to them.
    match /user_vocabulary/{docId} {
      function isOwnerByDocId() {
        return request.auth != null
          && docId.matches('^' + request.auth.uid + '_.*');
      }
      function isOwnerByData() {
        return request.auth != null
          && resource.data.uid == request.auth.uid;
      }
      allow read, delete: if request.auth != null
        && (isOwnerByDocId() || isOwnerByData());
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && (isOwnerByDocId() || isOwnerByData())
        && request.resource.data.uid == request.auth.uid;
    }

    // ── Lesson Logs ───────────────────────────────────────────────────────────
    // Users can read their own lesson history and create new entries.
    // Update/delete not permitted (immutable log).
    match /lesson_logs/{docId} {
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
    }

    // ── Image Cache ───────────────────────────────────────────────────────────
    // Public cache for Pexels images, keyed by vocabulary word.
    // Written by Next.js server actions which run without a Firebase Auth token
    // (client SDK is used server-side without a user session), so rules must
    // allow unauthenticated access. Data is non-sensitive (image URLs only).
    match /image_cache/{wordId} {
      allow read, write: if true;
    }

    // ── Verb Conjugation Cache ────────────────────────────────────────────────
    // Public cache for Gemini-generated verb conjugations.
    // Same reasoning as image_cache: server actions write without auth.
    match /verbs/{verbId} {
      allow read, write: if true;
    }

    // ── Lesson Mistakes ───────────────────────────────────────────────────────
    // Users can read, write, and delete their own mistake documents.
    match /lesson_mistakes/{docId} {
      allow read, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
    }

    // ── Pre-generated Lesson Cache ────────────────────────────────────────────
    // Written by server actions (no Firebase Auth token), read/deleted by the
    // authenticated user who owns the doc. Ownership is keyed by document ID
    // `{uid}_{lessonId}` so reads work even if legacy docs lack a `uid` field.
    match /lesson_pregen/{docId} {
      allow read, delete: if request.auth != null
        && docId.matches('^' + request.auth.uid + '_.*');
      allow create, update: if true;
    }
  }
}
